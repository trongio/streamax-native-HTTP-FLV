<Window x:Class="StreamaxDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Streamax Demo" Width="900" Height="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" CornerRadius="6">
            <vlc:VideoView x:Name="VideoView" />
        </Border>

        <TextBox Grid.Row="1" x:Name="UrlBox" Margin="0,12,0,0"
                 FontFamily="Consolas" FontSize="12"
                 Text=""
                 TextWrapping="Wrap" AcceptsReturn="False"
                 ToolTip="Paste a live FLV URL or call _player.StreamAsync(host: ..., uuid: ...)" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="PlayButton" Content="Play" Width="100" Click="OnPlayClick" />
            <TextBlock x:Name="StatusText" Text="Idle" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#a13"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
